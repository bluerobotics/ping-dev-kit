	(text "Datasheet recommends feedback R's equal \nor less than 1k to avoid poles. \n18Vp + 18VDC = ~22.5Vrms\nfor 1k and 100R, \n1k: P ~ 20V^2/1k = 400mW\n100: P ~ 3V^2/100 = 90mW"
		(exclude_from_sim no)
		(at 346.202 246.126 0)
