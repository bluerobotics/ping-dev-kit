	(text "Datasheet recommends feedback R's equal \nor less than 1k to avoid poles. \n18Vp + 18VDC = ~22.5Vrms\nfor 1k and 100R, \n1k: P ~ 20V^2/1k = 400mW\n100: P ~ 3V^2/100 = 90mW"
		(exclude_from_sim no)
		(at 259.842 166.116 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "072eaecf-3a64-49fa-a3ae-7bb53399420e")
	)
	(text "SIG_IN is 0-3.3Vpp from the DAC\nOutput should be up to 36Vpp\nMax Gain = 10.9"
		(exclude_from_sim no)
		(at 179.578 194.818 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "644a42ca-929f-47d0-a373-e32c6fa30d1e")
	)
	(text_box "R2R Resistor Ladder\nLooks like a 1k resistor connected to a DAC that outputs a voltage of:\nD0/256 + D1/128 + D2/64 + D3/32 + D4/16 + D5/8 + D6/4 + D7/2\nSo spans 0V to 3.29V when D[0..7] spans from all 0V to all 3.3V\nU1001A amplifies this so 0xff gives 5V out and 0x00 gives 0V out\nU1001B Inverts this to 0V and 5V respectively\n0x80 gives 2.52V, 0x7f gives 2.50V\n"
		(exclude_from_sim no)
		(at 50.8 177.8 0)
		(size 76.2 20.32)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1a06d2be-fb2e-445b-a183-278dd40d5244")
	)
	(text_box "VCC can be up to 36V \naccording to LT1794 \nSupply Abs Max"
		(exclude_from_sim no)
		(at 25.4 33.02 0)
		(size 25.4 15.24)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1a635486-8a32-4259-85aa-a7b524b94d62")
	)
	(text_box "Current out of SHDNREF pin is 1/64th of amplifier current.\nCurrent is set by 0.6V/4k7\nThis means amplifier current will be 8 mA"
		(exclude_from_sim no)
		(at 231.775 255.905 0)
		(size 45.085 12.1268)
		(margins 0.9525 0.9525 0.9525 0.9525)
